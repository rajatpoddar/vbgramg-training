# ============================================================
# Environment Configuration — Viksit Bharat - G RAM G Exam Portal
# Copy this file to `.env` and adjust the values:
#   cp .env.example .env
# ============================================================

# SQLite database location.
# Local dev: relative path (resolved against the project root).
# Docker:    absolute path on the mounted volume, e.g. file:/data/exam.db
DATABASE_URL="file:./prisma/dev.db"

# ---- Admin Portal (CHANGE THESE BEFORE DEPLOYMENT!) ----
# Password required to log in to the Admin Portal.
ADMIN_PASSWORD="admin123"

# Session token stored in the httpOnly admin cookie. Must be a long,
# random string. `middleware.ts` compares the cookie against this value.
ADMIN_TOKEN="dev-admin-token"

# Set COOKIE_SECURE=true ONLY if the portal is served over HTTPS.
# On a private NAS served over plain HTTP keep it false, otherwise the
# admin session cookie will not be sent by the browser.
COOKIE_SECURE="false"

# ---- Session Presentations (optional) ----
# Public base URL of the portal, used to build the file URLs that the
# Microsoft Office embed fetches for the PPTs in public/ppt/.
# Set this ONLY if the site is reachable at a fixed public domain; when
# unset, the URL is derived from each visitor's request (LAN IP / proxy).
# NEXT_PUBLIC_SITE_URL="https://exam.example.gov.in"
